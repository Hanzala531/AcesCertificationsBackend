# Application Configuration
APP_NAME=Aces Certifications
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://aces-certification.vercel.app,
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_ROUTE_WINDOW_MS=60000
RATE_LIMIT_ROUTE_MAX=30
RATE_LIMIT_RESOURCE_WINDOW_MS=60000
RATE_LIMIT_RESOURCE_MAX=600
RATE_LIMIT_ADMIN_MULTIPLIER=2
RATE_LIMIT_SUBADMIN_MULTIPLIER=1.5

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aces_certifications
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aces_certifications
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail)
EMAIL_PROVIDER=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@example.com

# Alternative: SMTP Configuration
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# ==========================================
# STRIPE PAYMENT CONFIGURATION (NEW)
# ==========================================
# Get these from: https://dashboard.stripe.com/developers/apikeys
# Publishable key (public, safe to expose to frontend)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (KEEP SECRET! Only in backend)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook signing secret
# Get from: Dashboard → Developers → Webhooks → [Your endpoint] → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: Stripe API Version (defaults to 2024-04-10)
STRIPE_API_VERSION=2024-04-10

# Optional: App URL for payment return redirects
APP_URL=http://localhost:3000

# Port Configuration
PORT=3000

# API Payload Encryption (Optional)
# Set true to require encrypted request payload wrappers and return encrypted responses.
API_PAYLOAD_ENCRYPTION_ENABLED=false
# Strong server-side secret used to derive AES-256-GCM key.
API_PAYLOAD_ENCRYPTION_KEY=change-this-strong-random-secret



# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyDo-8_irQQJ4Ow2m0fk9hnn0C9Jcg_W3Qk

# Audit Log Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_CAPTURE_READS=false
AUDIT_LOG_EXCLUDE_PATHS=/api/docs,/api-json,/api/admin/audit-logs
AUDIT_LOG_BATCH_SIZE=50
AUDIT_LOG_FLUSH_INTERVAL_MS=2000
AUDIT_LOG_MAX_QUEUE_SIZE=10000
AUDIT_LOG_MAX_WAIT_MS=10000
AUDIT_LOG_GDPR_RETENTION_DAYS=365
AUDIT_LOG_MAX_EXPORT_DAYS=90
