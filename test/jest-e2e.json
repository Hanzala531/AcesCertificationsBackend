{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^bcrypt$": "<rootDir>/test/bcrypt.mock.ts"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"]
}
